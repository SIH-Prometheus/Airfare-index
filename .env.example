# =============================================================================
# PROMETHEUS — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in the values.
# .env is git-ignored. This file (.env.example) is committed.
#
# For Docker Compose, these are injected via the 'environment:' block in
# docker-compose.yml. You do not need a .env file inside the container.
# =============================================================================

# ─── Runtime ─────────────────────────────────────────────────────────────────
PROMETHEUS_ENV=development          # development | production
PROMETHEUS_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR


# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Local development:
PROMETHEUS_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/airfare

# Docker (inside container — uses service name 'postgres'):
# PROMETHEUS_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/airfare

PROMETHEUS_DB_POOL_SIZE=10
PROMETHEUS_DB_MAX_OVERFLOW=20
PROMETHEUS_DB_POOL_TIMEOUT=30


# ─── MinIO Object Storage ────────────────────────────────────────────────────
# Local development:
PROMETHEUS_MINIO_ENDPOINT=localhost:9000

# Docker (inside container — uses service name 'minio'):
# PROMETHEUS_MINIO_ENDPOINT=minio:9000

PROMETHEUS_MINIO_ACCESS_KEY=minioadmin
PROMETHEUS_MINIO_SECRET_KEY=minioadmin
PROMETHEUS_MINIO_BUCKET_RAW=airfare-data
PROMETHEUS_MINIO_SECURE=false         # set true if using HTTPS


# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# The browser always accesses via localhost (not the Docker service name).
PROMETHEUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
# The browser uses this URL to call FastAPI.
# Always localhost (browser cannot resolve Docker service names).
NEXT_PUBLIC_API_URL=http://localhost:8000


# ─── Auth / Security ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PROMETHEUS_SECRET_KEY=REPLACE_THIS_WITH_A_GENERATED_SECRET


# ─── Redis (Phase 2 — not used in MVP) ───────────────────────────────────────
PROMETHEUS_REDIS_URL=redis://localhost:6379/0


# ─── Scraper ─────────────────────────────────────────────────────────────────
PROMETHEUS_SCRAPER_HEADLESS=true
PROMETHEUS_SCRAPER_TIMEOUT_MS=30000


# ─── ML / Forecasting (EXCLUDED from MVP — Phase 2 extension point) ──────────
# These variables are retained so existing ML code doesn't break at import.
PROMETHEUS_ML_CONTAMINATION=0.05
PROMETHEUS_FORECAST_HORIZON_DAYS=14