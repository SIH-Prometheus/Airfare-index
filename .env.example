# =============================================================================
# PROMETHEUS — Environment Variables
# =============================================================================
# This file is a TEMPLATE.
# Copy it to .env and replace placeholder values with your local/real values.
# NEVER put production secrets in this file.
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
PROMETHEUS_ENV=development
PROMETHEUS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
PROMETHEUS_DB_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/prometheus
PROMETHEUS_DB_POOL_SIZE=10
PROMETHEUS_DB_MAX_OVERFLOW=20
PROMETHEUS_DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# MinIO
# ---------------------------------------------------------------------------
PROMETHEUS_MINIO_ENDPOINT=localhost:9000
PROMETHEUS_MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
PROMETHEUS_MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
PROMETHEUS_MINIO_BUCKET_RAW=prometheus-raw
PROMETHEUS_MINIO_BUCKET_PARQUET=prometheus-parquet
PROMETHEUS_MINIO_SECURE=false

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
PROMETHEUS_REDIS_URL=redis://localhost:6379/0
PROMETHEUS_REDIS_ALERT_CHANNEL=prometheus:alerts

# ---------------------------------------------------------------------------
# FastAPI / Auth
# ---------------------------------------------------------------------------
PROMETHEUS_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_SECRET
PROMETHEUS_ACCESS_TOKEN_EXPIRE_MINUTES=15
PROMETHEUS_REFRESH_TOKEN_EXPIRE_DAYS=7
PROMETHEUS_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Scraper settings
# ---------------------------------------------------------------------------
PROMETHEUS_SCRAPER_HEADLESS=true
PROMETHEUS_SCRAPER_TIMEOUT_MS=30000
PROMETHEUS_SCRAPER_CONCURRENCY=3
PROMETHEUS_SCRAPER_RETRY_ATTEMPTS=3
PROMETHEUS_SCRAPER_RETRY_WAIT_SECONDS=5

# ---------------------------------------------------------------------------
# Index engine
# ---------------------------------------------------------------------------
PROMETHEUS_INDEX_BASE_DATE=2024-01-01
PROMETHEUS_INDEX_REBASE_DAY=1

# ---------------------------------------------------------------------------
# Alert thresholds
# ---------------------------------------------------------------------------
PROMETHEUS_ALERT_WOW_THRESHOLD_PCT=15.0
PROMETHEUS_ALERT_ZSCORE_THRESHOLD=2.5
PROMETHEUS_ALERT_DEDUP_HOURS=24

# ---------------------------------------------------------------------------
# ML / Forecasting
# ---------------------------------------------------------------------------
PROMETHEUS_ML_CONTAMINATION=0.05
PROMETHEUS_ML_RETRAIN_CRON=0 2 * * 1
PROMETHEUS_FORECAST_HORIZON_DAYS=14

# ---------------------------------------------------------------------------
# Prefect orchestration
# ---------------------------------------------------------------------------
PROMETHEUS_PREFECT_API_URL=http://localhost:4200/api
PROMETHEUS_PIPELINE_CRON=0 */6 * * *