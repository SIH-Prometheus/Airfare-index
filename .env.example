# =============================================================================
# PROMETHEUS — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# All variables are prefixed with PROMETHEUS_ and read by prometheus/config.py
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
PROMETHEUS_ENV=development           # development | staging | production
PROMETHEUS_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# PostgreSQL (async via asyncpg)
# ---------------------------------------------------------------------------
PROMETHEUS_DB_URL=postgresql+asyncpg://prometheus:secret@localhost:5432/prometheus
PROMETHEUS_DB_POOL_SIZE=10
PROMETHEUS_DB_MAX_OVERFLOW=20
PROMETHEUS_DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object store for raw data lake)
# ---------------------------------------------------------------------------
PROMETHEUS_MINIO_ENDPOINT=localhost:9000
PROMETHEUS_MINIO_ACCESS_KEY=minioadmin
PROMETHEUS_MINIO_SECRET_KEY=minioadmin
PROMETHEUS_MINIO_BUCKET_RAW=prometheus-raw
PROMETHEUS_MINIO_BUCKET_PARQUET=prometheus-parquet
PROMETHEUS_MINIO_SECURE=false        # true in production (HTTPS)

# ---------------------------------------------------------------------------
# Redis (cache + pub/sub for live alerts)
# ---------------------------------------------------------------------------
PROMETHEUS_REDIS_URL=redis://localhost:6379/0
PROMETHEUS_REDIS_ALERT_CHANNEL=prometheus:alerts

# ---------------------------------------------------------------------------
# FastAPI / Auth
# ---------------------------------------------------------------------------
PROMETHEUS_SECRET_KEY=change-me-to-a-random-64-char-hex-string
PROMETHEUS_ACCESS_TOKEN_EXPIRE_MINUTES=15
PROMETHEUS_REFRESH_TOKEN_EXPIRE_DAYS=7
PROMETHEUS_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Scraper settings
# ---------------------------------------------------------------------------
PROMETHEUS_SCRAPER_HEADLESS=true     # false for local debugging with browser
PROMETHEUS_SCRAPER_TIMEOUT_MS=30000
PROMETHEUS_SCRAPER_CONCURRENCY=3     # max parallel browser contexts
PROMETHEUS_SCRAPER_RETRY_ATTEMPTS=3
PROMETHEUS_SCRAPER_RETRY_WAIT_SECONDS=5

# ---------------------------------------------------------------------------
# Index engine
# ---------------------------------------------------------------------------
PROMETHEUS_INDEX_BASE_DATE=2024-01-01   # reference period start
PROMETHEUS_INDEX_REBASE_DAY=1            # day of month to chain-link (1=first Monday)

# ---------------------------------------------------------------------------
# Alert thresholds
# ---------------------------------------------------------------------------
PROMETHEUS_ALERT_WOW_THRESHOLD_PCT=15.0   # week-over-week % change threshold
PROMETHEUS_ALERT_ZSCORE_THRESHOLD=2.5     # Z-score threshold
PROMETHEUS_ALERT_DEDUP_HOURS=24           # suppress duplicate alerts for N hours

# ---------------------------------------------------------------------------
# ML / Forecasting
# ---------------------------------------------------------------------------
PROMETHEUS_ML_CONTAMINATION=0.05          # Isolation Forest contamination param
PROMETHEUS_ML_RETRAIN_CRON=0 2 * * 1     # weekly retrain at 02:00 Monday
PROMETHEUS_FORECAST_HORIZON_DAYS=14

# ---------------------------------------------------------------------------
# Prefect orchestration
# ---------------------------------------------------------------------------
PROMETHEUS_PREFECT_API_URL=http://localhost:4200/api
PROMETHEUS_PIPELINE_CRON=0 */6 * * *     # run every 6 hours
